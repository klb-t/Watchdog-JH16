{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watchdog.run-manifest.schema.json",
  "title": "WatchDog Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "status",
    "created_at",
    "application",
    "effective_config",
    "effective_config_sha256",
    "inputs",
    "steps",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "application": {
      "type": "object",
      "required": [
        "version",
        "git_commit"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        },
        "environment_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "effective_config": {
      "type": "object"
    },
    "effective_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "kind",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supersedes_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
