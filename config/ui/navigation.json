          "label": {
            "pl": "JH16 — replikacja",
            "en": "JH16 — replication"
          }
        },
        {
          "id": "evidence",
          "path": "/evidence",
          "capability": "evidence.review",
          "label": {
            "pl": "Przegląd dowodów",
            "en": "Evidence review"
          }
        }
      ]
