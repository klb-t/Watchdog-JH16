          "label": {
            "pl": "Źródła",
            "en": "Sources"
          }
        },
        {
          "id": "source-access",
          "path": "/source-access",
          "capability": "provider.view",
          "label": {
            "pl": "Dostęp do danych",
            "en": "Source access"
          }
        }
      ]
    },
    {
      "id": "analysis",
      "icon": "FlaskConical",
      "path": "/analysis",
      "label": {
        "pl": "Analiza",
        "en": "Analysis"
