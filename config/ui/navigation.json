        {
          "id": "diagnostics",
          "path": "/diagnostics",
          "capability": "diagnostics.view",
          "advanced": true,
          "label": {
            "pl": "Diagnostyka",
            "en": "Diagnostics"
          }
        }
      ]
    },
    {
      "id": "automation",
      "icon": "PlayCircle",
      "path": "/automation",
      "label": {
        "pl": "Automatyzacja",
        "en": "Automation"
      },
      "hint": {
        "pl": "Żeby działo się regularnie",
        "en": "Make it happen regularly"
