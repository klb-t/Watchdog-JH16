      "hint": {
        "pl": "Policzyć, narysować, porównać",
        "en": "Compute, chart, compare"
      },
      "views": [
        {
          "id": "workbench",
          "path": "/workbench",
          "capability": "workbench.view",
          "label": {
            "pl": "Warsztat",
            "en": "Workbench"
          }
        },
        {
          "id": "methods",
          "path": "/analyzers",
          "capability": "run.view",
          "label": {
            "pl": "Metody",
            "en": "Methods"
          }
