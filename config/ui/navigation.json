            "en": "Papers & extraction"
          }
        }
      ]
    },
    {
      "id": "knowledge",
      "icon": "BookOpen",
      "path": "/knowledge",
      "label": {
        "pl": "Baza wiedzy",
        "en": "Knowledge base"
      },
      "hint": {
        "pl": "Wszystko, co wiemy o X",
        "en": "Everything we know about X"
      },
      "views": [
        {
          "id": "substances",
          "path": "/memory",
          "capability_any": [
            "responder.lookup",
            "evidence.review"
          ],
          "label": {
            "pl": "Substancje",
            "en": "Substances"
          }
        },
        {
          "id": "responder",
          "path": "/responder",
          "capability": "responder.lookup",
          "label": {
            "pl": "Tryb ratownika",
            "en": "Responder view"
          }
        }
