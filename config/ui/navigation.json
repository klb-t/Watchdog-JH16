      "icon": "LayoutDashboard",
      "path": "/",
      "label": {
        "pl": "Pulpit",
        "en": "Dashboard"
      },
      "hint": {
        "pl": "Co się dzieje i gdzie wejść",
        "en": "What is happening and where to go"
      },
      "views": [
        {
          "id": "overview",
          "path": "/",
          "exact": true,
          "label": {
            "pl": "Przegląd",
            "en": "Overview"
          }
        }
      ]
    },
    {
      "id": "data",
      "icon": "Database",
      "path": "/data",
      "label": {
        "pl": "Dane i źródła",
        "en": "Data & Sources"
      },
      "hint": {
        "pl": "Znaleźć albo dodać dane",
        "en": "Find or add data"
      },
      "views": [
        {
          "id": "sources",
          "path": "/sources",
