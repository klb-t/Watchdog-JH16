{
  "version": "admission-policy-1",
  "invitation": {
    "defaultExpiryDays": 7,
    "maxExpiryDays": 30,
    "maxOpenLinkUses": 50,
    "noteMax": 1000
  },
  "application": {
    "reasonMin": 20,
    "reasonMax": 2000,
    "fieldMax": 200
  },
  "signin": {
    "codeLength": 8,
    "codeMinutes": 10,
    "maxAttempts": 5,
    "codesPerHour": 5,
    "operatorLinkMinutes": 15
  },
  "sessionTtlSeconds": 43200,
  "rateLimits": {
    "signin": {
      "count": 20,
      "windowMs": 900000
    },
    "preview": {
      "count": 60,
      "windowMs": 900000
    },
    "application": {
      "count": 10,
      "windowMs": 3600000
    }
  },
  "credentials": {
    "_note": "Storing an API key in a personal vault is above viewer (owner's rule of 2026-10-29: above viewer needs an administrator's approval). Set viewerMayStore to true only to let every viewer store keys.",
    "viewerMayStore": false
  }
}
