# WatchDog configuration. Copy to .env for local notes only — this file is
# names and comments, never values, and .env is gitignored.
#
# Nothing here is required to run locally. With none of it set, WatchDog runs
# offline on frozen fixtures with no authentication, which is what
# `npm run demo:jh16` and the test suite use.

# ---------------------------------------------------------------- identity
# Google OAuth *client id* for the web application. Not a secret; it is sent to
# the browser. Console → APIs & Services → Credentials → OAuth client ID.
# Setting this switches the instance from local mode to Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# Who may sign in, and as what. JSON object mapping an email address, or an
# "@domain" suffix, to one of: viewer | researcher | admin | dev.
# There is deliberately no wildcard and no default role.
#   {"you@example.com":"admin","@yourlab.org":"researcher"}
WATCHDOG_GRANTS=

# Signs session cookies. Secret. At least 32 characters. Rotating it signs
# everyone out, which is the intended way to revoke every session at once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_KEY=

# ---------------------------------------------------------------- providers
# Secret. Enables the text.generate capability: narrative prose and, later, the
# method compiler. A model never computes, rounds or adjusts a scientific value.
OPENROUTER_API_KEY=

# Secret. Enables live search result counts (the serp_result_count source).
# This provider is metered; every run against it spends credit.
SERPAPI_API_KEY=

# Any OpenAI-compatible endpoint instead of OpenRouter — a local llama.cpp,
# vLLM or Ollama server, or another vendor. All three are needed together.
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------- storage
# 'local' (default) or 'gcs'. In production the startup check refuses to run
# with container-local storage, because Cloud Run's filesystem is ephemeral and
# every archived raw response would be lost on restart.
STORE_BACKEND=
GCS_BUCKET=
GCS_PREFIX=

# Where the SQLite file lives. In production this must be on a mounted volume.
DB_PATH=
STORE_PATH=

# Colon-separated paths treated as durable mounts. Defaults to /mnt.
WATCHDOG_DURABLE_PATHS=

# ---------------------------------------------------------------- escape hatches
# Both refuse-to-start checks can be waived, and both have to be typed out on
# purpose so neither state is reachable by forgetting a variable.
# WATCHDOG_ALLOW_OPEN_INSTANCE=true    # production with no authentication
# WATCHDOG_ALLOW_EPHEMERAL_STORAGE=true # production with throwaway storage

# ---------------------------------------------------------------- diagnostics
# OFF | ERRORS | NORMAL | TRACE
WATCHDOG_DIAGNOSTICS_MODE=
WATCHDOG_DIAGNOSTICS_DIR=

# Personal API-key vault: optional base64-encoded 32-byte master key from a secret manager.
# Without this, the first saved personal key creates a private 0600 master.key next to DB_PATH.
WATCHDOG_VAULT_KEY=
# Optional absolute path for the local master key. Back it up separately from the encrypted DB.
WATCHDOG_VAULT_KEY_FILE=
